-- Disney Infinity Complete - ZoneList Patch (LegacyPlaysets)
-- Target buffer: presentation/zonelist.lua (221806 bytes)
-- Registers unlisted worlds as Toy Box zones with player spawning enabled.

local R = ZoneList and ZoneList.Records
local Z = R and R.Zones
if not (R and Z and R.InheritList) then return end

-- 1. Moana Prototypes (Beautiful Corner Cove, Test Stuff, Motunui)
local moana_zones = {
    { "Moana_Corner_Cove",         "worlds/moa_beautiful_corner_cove/moa_beautiful_corner_cove" },
    { "moa_test_stuff_tb",         "worlds/moa_test_stuff/moa_test_stuff" },
    { "MOA_Motunui",               "worlds/moa_motunui/moa_motunui" },
    { "MOA_Ocean",                 "worlds/moa_ocean/moa_ocean" },
    { "MOA_Polatu",                "worlds/moa_polatu/moa_polatu" },
    { "MOA_Tefiti",                "worlds/moa_tefiti/moa_tefiti" },
    { "MOA_Motonui_Dungeon",       "worlds/moa_motonui_dungeon/moa_motonui_dungeon" },
    { "MOA_Polatu_Dungeon",        "worlds/moa_polatu_dungeon/moa_polatu_dungeon" },
    { "MOA_Tefiti_Dungeon",        "worlds/moa_tefiti_dungeon/moa_tefiti_dungeon" },
}

for i = 1, #moana_zones do
    local zone, path = moana_zones[i][1], moana_zones[i][2]
    if not Z[zone] then
        Z[zone] = {
            ReturnToHubString = "Scn_ReturnToyBox",
            _Inherits_ = "Inherit_RumpusRoom_Parent",
            _ShowInMenu_ = true,
            availableInConsumerBuild = true,
            availableInShippingBuild = true,
            isPrebuiltToyBox = false,
            SplitScreenAllowed = true,
            ZonePath = path,
        }
    else
        Z[zone].ZonePath = path
        Z[zone]._Inherits_ = "Inherit_RumpusRoom_Parent"
        Z[zone].isPrebuiltToyBox = false
    end
end

