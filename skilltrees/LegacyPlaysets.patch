-- Disney Infinity Complete - ZoneList Patch (LegacyPlaysets)
-- Target buffer: presentation/zonelist.lua (221806 bytes)
-- Registers all cut content, Moana, Scarif and developer prototype worlds as Prebuilt Toy Box zones
-- with valid 3.0 player spawning (TCW_Anakin / chosen hero).

local R = ZoneList and ZoneList.Records
local Z = R and R.Zones
if not (R and Z and R.InheritList) then return end

-- ============================================================================
-- 1. GLOBAL DEFAULTS & TOY BOX SPAWNING RESCUE
-- ============================================================================
-- Fix the non-existent DI 1.0 "AV_MrIncredible" / "AV_Sparkman" fallback
-- that caused Player 0 creation to fail and leave the camera empty.
if R._DefaultValues_ then
    R._DefaultValues_.DefaultAvatar = "TCW_Anakin"
    R._DefaultValues_.DefaultAvatar2 = "TCW_Ahsoka"
    R._DefaultValues_.DefaultAvatar3 = "TCW_Yoda"
    R._DefaultValues_.DefaultAvatar4 = "TCW_ObiWan"
    R._DefaultValues_.FallbackAvatar = "TCW_Anakin"
end

local IRP = R.InheritList.Inherit_RumpusRoom_Parent
if IRP then
    IRP.DefaultAvatar = "TCW_Anakin"
    IRP.FallbackAvatar = "TCW_Anakin"
    IRP.ToyWipe_ForceEnable = false
    IRP.ToyWipe_Mode = "None"
    IRP.ToyWipe_LoadWipesUntil = nil
    IRP.InitPlayersAtClosestCheckpoint = false
    IRP.JoiningPlayersStartAtClosestCheckpoint = false
end

