    R._DefaultValues_.DefaultAvatar = "TCW_Anakin"
    R._DefaultValues_.DefaultAvatar2 = "TCW_Ahsoka"
    R._DefaultValues_.DefaultAvatar3 = "TCW_Yoda"
    R._DefaultValues_.DefaultAvatar4 = "TCW_ObiWan"
    R._DefaultValues_.FallbackAvatar = "TCW_Anakin"
end

local IRP = R.InheritList.Inherit_RumpusRoom_Parent
if IRP then
    IRP.DefaultAvatar = "TCW_Anakin"
    IRP.FallbackAvatar = "TCW_Anakin"
    IRP.ToyWipe_ForceEnable = false
    IRP.ToyWipe_Mode = "None"
    IRP.ToyWipe_LoadWipesUntil = nil
    IRP.InitPlayersAtClosestCheckpoint = false
    IRP.JoiningPlayersStartAtClosestCheckpoint = false
end

